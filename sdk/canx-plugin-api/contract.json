{
  "manifestVersion": 1,
  "apiVersion": "2.0",
  "capabilities": [
    "tools.invoke",
    "services.provide",
    "services.invoke",
    "ui.page",
    "ui.contribute",
    "ui.configuration",
    "ui.remoteImages",
    "playback.read",
    "playback.control",
    "downloads.read",
    "downloads.manage",
    "downloads.prompt",
    "media.stream",
    "http",
    "storage",
    "secrets"
  ],
  "uiSlots": {
    "page": ["navigation.plugins"],
    "panel": ["home.panel", "downloads.details", "playback.sidebar"],
    "command": ["command.palette"],
    "menu": ["menu.app", "menu.downloads", "menu.playback"],
    "setting": ["settings.plugins"],
    "statusCard": ["home.status", "downloads.status", "playback.status"]
  },
  "uiComponents": [
    "stack",
    "viewStack",
    "grid",
    "scroll",
    "card",
    "separator",
    "spacer",
    "expander",
    "tabs",
    "tab",
    "text",
    "link",
    "icon",
    "image",
    "badge",
    "progress",
    "spinner",
    "alert",
    "emptyState",
    "keyValue",
    "button",
    "textInput",
    "searchInput",
    "textArea",
    "numberInput",
    "toggle",
    "select",
    "radioGroup",
    "slider",
    "list",
    "gallery",
    "dataTable"
  ],
  "actions": {
    "playback.read": [
      "get",
      "capabilities",
      "chapter.list",
      "bookmark.list",
      "audioDevice.list",
      "shader.list",
      "diagnostics.get"
    ],
    "playback.control": [
      "play",
      "pause",
      "togglePause",
      "stop",
      "seek",
      "playlist.play",
      "playlist.next",
      "playlist.previous",
      "volume.set",
      "brightness.set",
      "mute.set",
      "speed.set",
      "audioDevice.set",
      "filter.video.set",
      "filter.audio.set",
      "filter.clear",
      "track.select",
      "subtitle.visibility.set",
      "subtitle.delay.set",
      "subtitle.style.set",
      "color.set"
    ],
    "downloads.read": ["list", "get", "global.get", "capabilities", "connections"],
    "downloads.manage": [
      "pause",
      "resume",
      "schedule.set",
      "move"
    ]
  }
}
