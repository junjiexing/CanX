{
  "manifestVersion": 1,
  "id": "org.canx.search.bitmagnet",
  "name": "bitmagnet Torrent Search",
  "description": "Headless GraphQL search service for a local bitmagnet index.",
  "version": "1.2.0",
  "apiVersion": "2.0",
  "entry": "dist/main.js",
  "configuration": { "title": "bitmagnet 设置" },
  "permissions": [
    { "capability": "services.provide", "scopes": ["org.canx.bittorrent.search"] },
    { "capability": "http", "scopes": ["127.0.0.1"] },
    { "capability": "ui.configuration" },
    { "capability": "storage" }
  ]
}
