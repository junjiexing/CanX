# Overrides the builtin x64-windows host triplet (pkgconf tools and the host
# Vulkan loader used by the dependency audit). Only Release output is needed.
set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE dynamic)
set(VCPKG_BUILD_TYPE release)
