diff --git a/src/d3d11/meson.build b/src/d3d11/meson.build
index d4c4b441..1780faf4 100644
--- a/src/d3d11/meson.build
+++ b/src/d3d11/meson.build
@@ -8 +8,5 @@ d3d11_deps = [
-  dependency('spirv-cross-c-shared', version: '>=0.29.0', required: d3d11),
+  dependency(
+    host_machine.system() == 'windows' ? 'spirv-cross-c' : 'spirv-cross-c-shared',
+    version: '>=0.29.0', required: d3d11,
+    static: host_machine.system() == 'windows',
+  ),
diff --git a/src/glsl/meson.build b/src/glsl/meson.build
index c9a85429..e5f78769 100644
--- a/src/glsl/meson.build
+++ b/src/glsl/meson.build
@@ -46 +46,4 @@ elif not glslang_req.disabled()
-  prefer_static = get_option('prefer_static')
+  # The MSVC ABI uses the same .lib suffix for static and import libraries.
+  # glslang from our static vcpkg triplet must be selected explicitly without
+  # globally forcing Windows SDK import libraries to be treated as static.
+  prefer_static = get_option('prefer_static') or host_machine.system() == 'windows'
@@ -62 +65 @@ elif not glslang_req.disabled()
-    glslang_deps += cxx.find_library('glslang', required: required, static: static)
+    glslang_deps += cxx.find_library('glslang', required: required, static: static, dirs: vulkan_lib_dirs)
