{
  "manifestVersion": 1,
  "id": "org.canx.search.jackett",
  "name": "Jackett Torrent Search",
  "description": "Headless Torznab search service for a local Jackett instance.",
  "version": "1.2.0",
  "apiVersion": "2.0",
  "entry": "dist/main.js",
  "configuration": { "title": "Jackett 设置" },
  "permissions": [
    { "capability": "services.provide", "scopes": ["org.canx.bittorrent.search"] },
    { "capability": "http", "scopes": ["127.0.0.1"] },
    { "capability": "ui.configuration" },
    { "capability": "storage" },
    { "capability": "secrets", "scopes": ["api-key"] }
  ]
}
