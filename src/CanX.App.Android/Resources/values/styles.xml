<resources>
  <style name="CanXMainTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:windowNoTitle">true</item>
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#0078D4</item>
    <item name="android:statusBarColor">#101820</item>
    <item name="android:navigationBarColor">#101820</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="CanXPlaybackTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    <item name="android:windowBackground">#000000</item>
    <item name="android:colorAccent">#4A90D9</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:statusBarColor">#000000</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>
</resources>
