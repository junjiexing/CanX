<Window
    x:Class="CanX.App.PluginUninstallConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="卸载插件"
    Icon="avares://CanX.App/Assets/CanXLogo.png"
    Width="500"
    Height="230"
    CanResize="False"
    AutomationProperties.Name="卸载插件确认"
    WindowStartupLocation="CenterOwner">
  <Border
      x:Name="DialogFrame"
      Background="{DynamicResource CanXBackgroundBrush}"
      BorderBrush="{DynamicResource CanXBorderBrush}"
      BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border
          x:Name="CustomTitleBar"
          Height="30"
          Background="{DynamicResource CanXTitleBarBrush}"
          BorderBrush="{DynamicResource CanXBorderBrush}"
          BorderThickness="0,0,0,1"
          PointerPressed="OnTitleBarPointerPressed">
        <Grid>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="卸载插件" />
          <Button HorizontalAlignment="Right" Classes="titlebar close" Click="OnCancelClick" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="20,18" Spacing="10">
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Foreground="{DynamicResource CanXMutedTextBrush}" Text="插件代码将被删除。插件隔离数据和系统凭证会保留，避免误删用户数据。" TextWrapping="Wrap" />
      </StackPanel>
      <Border Grid.Row="2" Background="{DynamicResource CanXPanelBrush}" BorderBrush="{DynamicResource CanXBorderBrush}" BorderThickness="0,1,0,0" Padding="12">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
          <Button MinWidth="90" Click="OnCancelClick" Content="取消" IsCancel="True" />
          <Button MinWidth="90" Click="OnConfirmClick" Content="卸载" IsDefault="True" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
