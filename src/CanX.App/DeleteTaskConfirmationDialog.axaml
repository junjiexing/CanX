<Window
    x:Class="CanX.App.DeleteTaskConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="删除任务"
    Icon="avares://CanX.App/Assets/CanXLogo.png"
    Width="520"
    Height="290"
    CanResize="False"
    AutomationProperties.Name="删除任务确认对话框"
    WindowStartupLocation="CenterOwner">
  <Border
      x:Name="DialogFrame"
      Background="{DynamicResource CanXBackgroundBrush}"
      BorderBrush="{DynamicResource CanXBorderBrush}"
      BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border
          x:Name="CustomTitleBar"
          Height="30"
          Background="{DynamicResource CanXTitleBarBrush}"
          BorderBrush="{DynamicResource CanXBorderBrush}"
          BorderThickness="0,0,0,1"
          PointerPressed="OnTitleBarPointerPressed">
        <Grid>
          <Image
              Width="16"
              Height="16"
              Margin="8,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Source="avares://CanX.App/Assets/CanXLogo.png"
              Stretch="Uniform" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="删除任务" />
          <Button
              HorizontalAlignment="Right"
              Classes="titlebar close"
              AutomationProperties.Name="关闭删除确认"
              Click="OnCancelClick"
              ToolTip.Tip="关闭" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,18" Spacing="12">
        <TextBlock x:Name="PromptText" FontSize="18" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
        <TextBlock Foreground="{DynamicResource CanXMutedTextBrush}" Text="下载记录将从 CanX 中移除。" TextWrapping="Wrap" />
        <CheckBox
            x:Name="DeleteFilesCheckBox"
            AutomationProperties.Name="同时删除本地文件"
            Content="同时删除本地文件" />
        <TextBlock
            Foreground="{DynamicResource CanXDangerBrush}"
            Text="勾选后会删除此任务位于下载目录中的文件，此操作无法撤销。"
            TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource CanXPanelBrush}" BorderBrush="{DynamicResource CanXBorderBrush}" BorderThickness="0,1,0,0" Padding="12">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
          <Button MinWidth="90" Click="OnCancelClick" Content="取消" IsCancel="True" IsDefault="True" />
          <Button MinWidth="90" Classes="danger" Click="OnConfirmClick" Content="删除" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
