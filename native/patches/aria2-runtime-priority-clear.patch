+  size_t getRuntimePriorityRevision() const
+  {
+    return runtimePriorityRevision_;
+  }
+
+  bool isRuntimePriorityEnabled() const { return runtimePriorityEnabled_; }
+
+  bool isRuntimePriorityPiece(size_t index) const
+  {
+    return runtimePriorityEnabled_ && index >= runtimePriorityFirst_ &&
+           index <= runtimePriorityLast_;
+  }
+
   void setWrDiskCache(WrDiskCache* wrDiskCache) { wrDiskCache_ = wrDiskCache; }
