# Overrides the builtin arm64-windows-static triplet so vcpkg builds only the
# Release variants. The shipped application links Release static libraries
# exclusively; nothing consumes the Debug variants.
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
