   void setRuntimePriorityPieceRange(size_t firstPiece, size_t lastPiece)
   {
+    if (!runtimePriorityEnabled_ || runtimePriorityFirst_ != firstPiece ||
+        runtimePriorityLast_ != lastPiece) {
+      ++runtimePriorityRevision_;
+    }
     runtimePriorityEnabled_ = true;
     runtimePriorityFirst_ = firstPiece;
     runtimePriorityLast_ = lastPiece;
   }

+  void clearRuntimePriorityPieceRange()
+  {
+    if (runtimePriorityEnabled_) {
+      ++runtimePriorityRevision_;
+    }
+    runtimePriorityEnabled_ = false;
+  }
